---
import MaterialPage from "@/components/MaterialPage.astro";
import { materialBySlug } from "@/data/materials";

const entry = materialBySlug("sliding-door");
if (!entry) throw new Error("Unknown material");
---

<MaterialPage entry={entry}>
  <p slot="intro">
    <code>SlidingDoorMaterial</code> cuts the text into panes and slides them, one after another,
    out of their frames and back. Each pane waits for the one before it to get a little way along
    before it moves, so the copies seem to drag each other. The word splits, reorganises itself,
    and does it again.
  </p>

  <Fragment slot="uDivisions">
    <p>How many panes to cut the text into along the animation axis: vertical by default, horizontal when <code>uAnimateHorizontal</code> is on.</p>
  </Fragment>
  <Fragment slot="uDivisions-value">
    <p>Any float. Whole numbers make even panes.</p>
  </Fragment>

  <Fragment slot="uDivisionWidth">
    <p>How far a pane travels before the next one sets off. Small values make a tight ripple; large ones make the panes move almost in turn.</p>
  </Fragment>
  <Fragment slot="uDivisionWidth-value">
    <p>A float from <code>0.0</code> to <code>1.0</code>, as a fraction of the text’s total height.</p>
  </Fragment>

  <Fragment slot="uAnimateHorizontal">
    <p>A switch. Off, the panes slide vertically; on, they slide horizontally.</p>
  </Fragment>
  <Fragment slot="uAnimateHorizontal-value">
    <p>A float used as a boolean: <code>0.0</code> for off, <code>1.0</code> for on.</p>
  </Fragment>

  <Fragment slot="uFlipAnimationDirection">
    <p>A switch that reverses the direction of travel. Vertical animation runs bottom to top by default and horizontal runs right to left; this flips whichever is active.</p>
  </Fragment>
  <Fragment slot="uFlipAnimationDirection-value">
    <p>A float used as a boolean: <code>0.0</code> for off, <code>1.0</code> for on.</p>
  </Fragment>

  <Fragment slot="uSpeed">
    <p>How fast the panes slide.</p>
  </Fragment>
  <Fragment slot="uSpeed-value">
    <p>Any float. It multiplies <code>uGlobalTime</code>, so <code>0.0</code> freezes the doors mid-slide.</p>
  </Fragment>
</MaterialPage>
