---
import MaterialPage from "@/components/MaterialPage.astro";
import { materialBySlug } from "@/data/materials";

const entry = materialBySlug("rolling-distort");
if (!entry) throw new Error("Unknown material");
---

<MaterialPage entry={entry}>
  <p slot="intro">
    <code>RollingDistortMaterial</code> is the picture on a television that has given up. A wave
    rolls across the text in an endless loop and shoves the image around as it passes, with a
    layer of finer noise underneath. The uniforms describe the wave (how wide, how many cycles, how
    tall), the noise (how busy, how tall), and the line they both travel along.
  </p>

  <Fragment slot="uSineDistortSpread">
    <p>The width of the wave: how much of the text it covers from its leading edge to its trailing one.</p>
  </Fragment>
  <Fragment slot="uSineDistortSpread-value">
    <p>A float from <code>0.0</code> to <code>1.0</code>, as a fraction of the distance from <code>uDistortPosition</code> along the axis perpendicular to <code>uRotation</code>. Above <code>0.5</code> the wave starts again before it has finished, which is its own kind of interesting.</p>
  </Fragment>

  <Fragment slot="uSineDistortCycleCount">
    <p>How many crests and troughs fit inside the spread.</p>
  </Fragment>
  <Fragment slot="uSineDistortCycleCount-value">
    <p>Any float. <code>1.0</code> is a single crest; <code>2.0</code> is a full cycle. Fractions such as <code>3.5</code> leave artefacts you may enjoy.</p>
  </Fragment>

  <Fragment slot="uSineDistortAmplitude">
    <p>How tall the crests and troughs are.</p>
  </Fragment>
  <Fragment slot="uSineDistortAmplitude-value">
    <p>Any float, as a fraction of the distance along the line running from <code>uDistortPosition</code> at the angle of <code>uRotation</code>.</p>
  </Fragment>

  <Fragment slot="uNoiseDistortVolatility">
    <p>Under the wave sits a constant, noisy distortion with no position or spread of its own. This is how quickly that noise varies along the distortion axis.</p>
  </Fragment>
  <Fragment slot="uNoiseDistortVolatility-value">
    <p>Any float. Higher is busier.</p>
  </Fragment>

  <Fragment slot="uNoiseDistortAmplitude">
    <p>How far the noise pushes the pixels.</p>
  </Fragment>
  <Fragment slot="uNoiseDistortAmplitude-value">
    <p>Any float, measured like <code>uSineDistortAmplitude</code>.</p>
  </Fragment>

  <Fragment slot="uDistortPosition">
    <p>The centre of the wave and of the noise. Animation travels through this point along the axis perpendicular to <code>uRotation</code>.</p>
  </Fragment>
  <Fragment slot="uDistortPosition-value">
    <p>A pair of floats from <code>0.0</code> to <code>1.0</code>, relative to the text’s width and height.</p>
  </Fragment>

  <Fragment slot="uRotation">
    <p>The angle, in degrees, along which all distortion is applied. The wave’s amplitude rises and falls along this angle; its travel is perpendicular to it.</p>
  </Fragment>
  <Fragment slot="uRotation-value">
    <p>A float from <code>0.0</code> to <code>360.0</code>.</p>
  </Fragment>

  <Fragment slot="uSpeed">
    <p>How fast the wave travels.</p>
  </Fragment>
  <Fragment slot="uSpeed-value">
    <p>Any float; the default is deliberately slow. It multiplies <code>uGlobalTime</code>, so <code>0.0</code> holds the wave still.</p>
  </Fragment>
</MaterialPage>
