---
import MaterialTile from "@/components/MaterialTile.astro";
import PageHeader from "@/components/PageHeader.astro";
import { materials } from "@/data/materials";
import Base from "@/layouts/Base.astro";
---

<Base
  title="Materials · blotter.ts"
  description="The five effects bundled with blotter.ts, each with live controls."
  current="materials"
>
  <PageHeader
    eyebrow="Materials"
    title="Five effects, ready to drop in."
    lead="A material describes how a text is drawn: a fragment shader with named uniforms you can change while it runs. These five ship in blotter.ts/materials."
    class="mb-12"
  />
  <ul class="grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
    {materials.map((entry) => <MaterialTile entry={entry} />)}
  </ul>
  <p class="mt-12 max-w-2xl text-base text-ink-2">
    None of them quite right? <a href="/guide/custom-materials" class="text-accent underline">Write your own</a>:
    a material is one GLSL function, and the bundled ones are written the same way you would.
  </p>
</Base>
