---
import CodeBlock from "@/components/CodeBlock.astro";
import Hero from "@/components/Hero.astro";
import InstallCommand from "@/components/InstallCommand.astro";
import MaterialTile from "@/components/MaterialTile.astro";
import { materials } from "@/data/materials";
import Base from "@/layouts/Base.astro";

const snippet = `import { Blotter, Text } from "blotter.ts";
import { ChannelSplitMaterial } from "blotter.ts/materials";

const text = new Text("Hello", { family: "serif", size: 96 });
const blotter = new Blotter(new ChannelSplitMaterial(), { texts: text });

blotter.forText(text)?.appendTo(document.body);
await blotter.ready;`;

const doors = [
  {
    href: "/guide/getting-started",
    title: "Guide",
    text: "Your first text on a canvas in five minutes, then uniforms, events and custom shaders.",
  },
  {
    href: "/api",
    title: "API reference",
    text: "Every export of blotter.ts and blotter.ts/materials, with the signatures pulled from the types.",
  },
  {
    href: "/guide/migrating",
    title: "Migrating from Blotter.js",
    text: "Same renderer, new API. What changed, what stayed, and the before-and-after of the classic example.",
  },
];

const link =
  "inline-flex items-center gap-1.5 text-small font-medium text-accent underline decoration-accent/40 underline-offset-[0.2em] transition-colors hover:decoration-accent";
---

<Base title="blotter.ts — text effects for the web" layout={false}>
  <section class="border-b border-rule">
    <Hero />
  </section>

  <section class="mx-auto w-full max-w-336 px-gutter py-section">
    <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="min-w-0 max-w-2xl">
        <p class="eyebrow mb-5">blotter.ts</p>
        <h1 class="font-display text-display text-ink text-balance">
          <em>Eccentric</em> ways to render words on screen.
        </h1>
        <p class="mt-6 text-xl/normal text-ink-2 text-pretty">
          Blotter hands the words on your page to a GLSL shader and gives each one back as a canvas
          that still reads like type. One WebGL context, one draw call, every text on screen.
        </p>
        <p class="mt-4 text-base text-ink-2">
          A TypeScript rewrite of Bradley Griffith’s Blotter: ESM, typed, tree-shakeable, with
          <code class="rounded-sm bg-surface px-1.5 py-0.5 text-[0.9em]">three</code> as a peer dependency.
        </p>
      </div>
      <div class="min-w-0 lg:pt-10">
        <InstallCommand />
        <CodeBlock code={snippet} lang="ts" class="mt-4" />
        <p class="mt-4">
          <a href="/guide/getting-started" class={link}>Start with the guide</a>
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-rule">
    <div class="mx-auto w-full max-w-336 px-gutter py-section">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow mb-3">Materials</p>
          <h2 class="font-display text-h2 text-ink text-balance">Five effects, ready to drop in.</h2>
          <p class="mt-3 text-base text-ink-2 text-pretty">
            A material is a shader with dials. Each one ships with live uniforms you can tune while it runs.
          </p>
        </div>
        <a href="/materials" class={link}>All materials</a>
      </div>
      <ul class="grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {materials.map((entry) => <MaterialTile entry={entry} />)}
      </ul>
    </div>
  </section>

  <section class="border-t border-rule">
    <div class="mx-auto w-full max-w-336 px-gutter py-section">
      <ul class="grid list-none gap-5 p-0 md:grid-cols-3">
        {
          doors.map((door) => (
            <li>
              <a
                href={door.href}
                class="group flex h-full flex-col rounded-lg border border-rule bg-surface p-6 transition-colors hover:border-ink-3"
              >
                <h2 class="font-display text-h3 text-ink">{door.title}</h2>
                <p class="mt-2 flex-1 text-small text-ink-2">{door.text}</p>
                <span class="mt-5 text-small font-medium text-accent">
                  Open
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
