---
import type { MaterialEntry } from "@/data/materials";

interface Props {
  entry: MaterialEntry;
}

const { entry } = Astro.props;
---

<!-- The card clips its content, so the focus ring goes on the card rather than
     the link inside it, where `overflow-hidden` would cut it away. -->
<li
  class="overflow-hidden rounded-lg border border-rule bg-surface transition-colors hover:border-ink-3 has-[a:focus-visible]:border-ink-3 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-accent"
>
  <a href={`/materials/${entry.slug}`} class="block focus-visible:outline-hidden">
    <div
      class="flex aspect-4/3 items-center justify-center overflow-hidden font-display data-fallback:text-[96px] data-fallback:leading-none [&_.b-canvas]:mx-auto [&_.b-canvas]:max-w-full"
      data-tile={entry.slug}
      aria-hidden="true"
      data-pagefind-ignore
    >
    </div>
    <div class="border-t border-rule bg-paper px-4 py-3">
      <p class="text-small font-medium text-ink">{entry.name}</p>
      <p class="mt-0.5 text-caption text-ink-2">{entry.tagline}</p>
    </div>
  </a>
</li>

<script>
  import "@/islands/tiles";
</script>
