---
import type { MaterialEntry } from "../data/materials";
import Base from "../layouts/Base.astro";
import ApiMember from "./ApiMember.astro";
import CodeBlock from "./CodeBlock.astro";
import MaterialDemo from "./MaterialDemo.astro";

interface Props {
  entry: MaterialEntry;
}

const { entry } = Astro.props;
const construction = `import { ${entry.className} } from "blotter.ts/materials";

const material = new ${entry.className}();`;
---

<Base title={`${entry.name} · blotter.ts`} description={entry.blurb} current="materials">
  <div class="pt-content-top pb-masthead" data-material={entry.slug}>
    <MaterialDemo />
    <div class="ml-auto w-full max-w-content max-md:max-w-full">
      <div class="mb-gutter">
        <h2>{entry.name}</h2>
        <slot name="intro" />
        <p>
          <code>{entry.className}</code> extends <code>Material</code>, and therefore has the same
          properties and functions as <a href="/documentation#material"><code>Material</code></a>.
        </p>
      </div>
      <ul class="list-none p-0 [&>li]:mt-lh [&>li:first-child]:mt-0">
        <ApiMember name="construction" id="construction">
          <CodeBlock code={construction} lang="ts" />
        </ApiMember>
        <ApiMember name="uniforms" code="material.uniforms" id="uniforms">
          <p class="description">
            An object that holds the uniforms that describe how the material's effects should be
            rendered. Each entry is a live <a href="/documentation#uniforms"><code>UniformInterface</code></a>:
            assign to its <code>value</code> and the running effect updates. You should not replace
            this property directly.
          </p>
          <ul class="ml-lh list-none p-0 text-[14px] leading-normal [&>li]:mt-lh">
            <slot />
          </ul>
        </ApiMember>
      </ul>
    </div>
  </div>
</Base>
