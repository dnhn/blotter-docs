---
import type { SidebarGroup } from "@/data/nav";

interface Props {
  groups: readonly SidebarGroup[];
  pathname: string;
}

const { groups, pathname } = Astro.props;

// The page you are on: heavier, inked, with an accent rail in the left margin.
const page =
  "relative -mx-2 block rounded-sm px-2 py-1 transition-colors " +
  "before:absolute before:inset-y-1 before:left-0 before:w-[2px] before:rounded-full before:bg-accent before:opacity-0 before:transition-opacity before:content-[''] " +
  "aria-[current=page]:bg-surface aria-[current=page]:font-semibold aria-[current=page]:text-ink aria-[current=page]:before:opacity-100 " +
  "not-aria-[current=page]:text-ink-2 hover:bg-surface hover:text-ink motion-reduce:transition-none";

// The section you are reading: the rail replaces the group's hairline.
const section =
  "relative block py-1 pl-3 text-caption text-ink-2 transition-colors hover:text-ink " +
  "before:absolute before:inset-y-0.5 before:-left-px before:w-[2px] before:bg-accent before:opacity-0 before:transition-opacity before:content-[''] " +
  "aria-[current=location]:font-medium aria-[current=location]:text-ink aria-[current=location]:before:opacity-100 motion-reduce:transition-none";
---

<nav aria-label="Section" class="text-small">
  {
    groups.map((group) => (
      <div class="mb-7">
        <p class="eyebrow mb-3">{group.label}</p>
        <ul class="list-none space-y-0.5 p-0">
          {group.items.map((item) => {
            const active = item.href === pathname;
            return (
              <li>
                <a href={item.href} class={page} aria-current={active ? "page" : undefined}>
                  {item.title}
                </a>
                {active && item.sections?.length ? (
                  <ul class="mt-1.5 mb-2 ml-1 list-none border-l border-rule p-0" data-toc>
                    {item.sections.map((anchor) => (
                      <li>
                        <a href={`#${anchor.id}`} class={section}>
                          {anchor.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : null}
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</nav>

<script>
  import "@/islands/toc";
</script>
