---
interface Props {
  title?: string;
  kind?: "note" | "warn";
}

const { title, kind = "note" } = Astro.props;
---

<aside
  class:list={[
    "not-prose rounded-lg border-l-2 px-5 py-4 text-small",
    kind === "warn" ? "border-accent bg-accent-soft/60" : "border-ink-3 bg-surface",
  ]}
>
  {title && <p class="mb-1 font-medium text-ink">{title}</p>}
  <div class="[&>*+*]:mt-2">
    <slot />
  </div>
</aside>
