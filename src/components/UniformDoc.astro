---
import type { UniformSpec } from "@/lib/material-uniforms";

interface Props {
  uniform: UniformSpec;
}

const { uniform } = Astro.props;
const typeNote: Record<string, string> = {
  "1f": "a single float",
  "2f": "a pair of floats, as [x, y]",
  "3f": "three floats, as [x, y, z]",
  "4f": "four floats, as [x, y, z, w]",
};
---

<section id={`u-${uniform.name}`} class="not-prose border-t border-rule pt-6 [&>*+*]:mt-3">
  <h3 class="not-italic! font-mono! text-[1rem]! font-medium! mt-0!">
    <a href={`#u-${uniform.name}`} class="text-ink! no-underline! hover:text-accent!">{uniform.name}</a>
  </h3>
  <p class="flex flex-wrap gap-x-5 gap-y-1 text-caption text-ink-2">
    <span>type <code class="text-[0.95em]">"{uniform.type}"</code>, {typeNote[uniform.type]}</span>
    <span>default <code class="text-[0.95em]">{uniform.defaultValue}</code></span>
  </p>
  <div class="[&>*+*]:mt-3">
    <slot />
  </div>
  <details class="text-small">
    <summary class="cursor-pointer text-ink-2 hover:text-ink">Value</summary>
    <div class="mt-2 border-l border-rule pl-4 text-ink-2 [&>*+*]:mt-2">
      <slot name="value" />
    </div>
  </details>
</section>
