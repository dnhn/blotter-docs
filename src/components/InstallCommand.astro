---
const command = "npm install blotter.ts three";
---

<div>
  <div
    class="flex items-center justify-between gap-3 rounded-lg border border-rule bg-surface px-4 py-3 font-mono text-code"
  >
    <code
      class="min-w-0 overflow-x-auto bg-transparent p-0 whitespace-nowrap before:mr-2 before:text-ink-3 before:content-['$']"
      >{command}</code
    >
    <button
      type="button"
      class="shrink-0 cursor-pointer rounded-sm border border-rule bg-paper px-2.5 py-1 font-sans text-caption font-medium text-ink-2 transition-colors hover:border-ink-3 hover:text-ink"
      data-copy
      aria-label="Copy install command">Copy</button
    >
  </div>
  <p
    class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-caption text-ink-2 [&_a:hover]:text-ink [&_a:hover]:decoration-accent [&_a]:underline [&_a]:decoration-rule"
  >
    <a href="https://www.npmjs.com/package/blotter.ts">npm</a>
    <a href="https://github.com/dnhn/blotter">GitHub</a>
    <span>ESM · TypeScript · <code class="text-[0.95em]">three</code> as a peer dependency</span>
  </p>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const code = button.parentElement?.querySelector("code")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Failed";
      }
      setTimeout(() => {
        button.textContent = "Copy";
      }, 1500);
    });
  }
</script>
