---
import { Code } from "astro:components";

interface Props {
  code: string;
  lang?: "ts" | "js" | "sh" | "glsl" | "html";
  class?: string;
}

const { code, lang = "ts", class: className } = Astro.props;
---

<div
  class:list={[
    "code-block my-lh max-w-full",
    "[&_.astro-code]:overflow-x-auto [&_.astro-code]:p-lh [&_.astro-code]:font-mono [&_.astro-code]:text-editor [&_.astro-code]:[text-shadow:0_0_3px_var(--color-editor-glow)]",
    "[&_code]:rounded-none [&_code]:bg-transparent [&_code]:p-0 [&_code]:text-inherit [&_code]:text-[length:inherit] [&_code]:leading-[inherit]",
    className,
  ]}
>
  <Code code={code} lang={lang} theme="css-variables" wrap />
</div>
