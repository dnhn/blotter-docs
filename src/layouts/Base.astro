---
import Footer from "@/components/Footer.astro";
import Head from "@/components/Head.astro";
import Marginalia from "@/components/Marginalia.astro";
import Masthead from "@/components/Masthead.astro";
import Search from "@/components/Search.astro";
import type { NavId } from "@/data/nav";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  current?: NavId;
  /** Wrap the page in the padded page column. Off for full-bleed pages. */
  layout?: boolean;
  /** Include the page in the search index. */
  search?: boolean;
}

const { title, description, current, layout = true, search = true } = Astro.props;
---

<html lang="en" class="h-full">
  <head>
    <Head title={title} description={description} />
    <slot name="head" />
  </head>
  <body class="relative flex min-h-full flex-col bg-paper text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-200 focus:rounded-sm focus:bg-ink focus:px-3 focus:py-2 focus:text-paper"
      >Skip to content</a
    >
    <Marginalia />
    <Masthead current={current} />
    <main
      id="main"
      class:list={[
        "relative flex-1",
        layout && "mx-auto w-full max-w-336 px-gutter pt-page-top pb-section",
      ]}
      data-pagefind-body={search || undefined}
    >
      <slot />
    </main>
    <Footer />
    <Search />
  </body>
</html>
